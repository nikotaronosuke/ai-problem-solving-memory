# Example environment values for the Problem-Solving Memory service.
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# `.env` is git-ignored. Never put real secrets in this example file.

# --- Runtime -----------------------------------------------------------------

# Node runtime environment: development | test | production
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------

# PostgreSQL connection string. Required by anything that opens a database
# connection; code that does not touch the database runs without it.
#
# For local development, start the stack with `npm run supabase:start` and read
# the "DB URL" printed by `npm run db:status`, then paste it into `.env`.
# The URL reads as 127.0.0.1, but Docker publishes the port on all interfaces.
# Stop the stack with `npm run supabase:stop` when you are not using it.
#
# Shape only — replace every part. Do not commit a filled-in value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Ownership ---------------------------------------------------------------

# The owner that local development acts as. A UUID issued by the Memory Server,
# never an AI vendor, GitHub or other provider account id.
#
# Not a credential, and since P3-04 not a way into the API either. It names the
# owner that `owner:bootstrap` and `credential:issue` act on. Reaching `/v1`
# requires a credential: `npm run credential:issue -- --label "..."`.
#
# Generate one and create the matching row:
#   node -e "console.log(crypto.randomUUID())"   # paste the result below
#   npm run owner:bootstrap
#
# Deliberately not a well-formed UUID: copying this file without editing must
# fail immediately as an invalid owner, rather than look like a real one.
# Do not commit a filled-in value.
MEMORY_OWNER_ID=REPLACE_WITH_UUID

# --- HTTP server -------------------------------------------------------------

# Interface the server binds to. Loopback by default: this holds one person's
# memory, so exposing it to the network should be a deliberate choice rather
# than something a default did quietly. Blank is refused, not defaulted.
HOST=127.0.0.1

# Port to listen on. An integer from 1 to 65535.
PORT=3000
