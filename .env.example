# Example environment values for the Problem-Solving Memory service.
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# `.env` is git-ignored. Never put real secrets in this example file.

# --- Currently used by the runtime -------------------------------------------

# Node runtime environment: development | test | production
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Reserved, not implemented yet -------------------------------------------
# The values below are documentation only. They are intentionally commented out
# and are not read by the current code.

# P1-03 — Supabase / PostgreSQL connection.
# Placeholder shape only. Real connection values belong in `.env`, never here.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Phase 2 — HTTP surface of the Memory Server.
# PORT=3000
