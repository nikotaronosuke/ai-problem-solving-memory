{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // No build resolves anything to a sibling's source tree. This package
    // imports nothing at all, and clearing the mapping is what keeps that a
    // fact about the build rather than about today's imports.
    "paths": {},
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
