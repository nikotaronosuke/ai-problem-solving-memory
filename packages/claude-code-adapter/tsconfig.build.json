{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // A built adapter depends on the built client, through the workspace link
    // like any other dependency — not on the client's source tree, which
    // would land a second copy of it in this package's `dist`.
    "paths": {},
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
